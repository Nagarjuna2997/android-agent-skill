{
  "name": "android-agent-skill",
  "version": "0.3.0",
  "description": "Android app engineering skill and local-first tooling for coding agents: Kotlin/Compose patterns, capability recipes, checklists, templates, plus a CLI and MCP server for Gradle, devices and evidence.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "android-agent": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "data",
    "SKILL.md",
    "CLAUDE.md",
    "GEMINI.md",
    "skill.json",
    "patterns",
    "capabilities",
    "checklists",
    "docs",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages tests scripts benchmarks",
    "test": "npm run build && node --test tests/*.test.mjs",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run content:check",
    "prepack": "npm run build",
    "package:test": "node scripts/package-test.mjs",
    "content:check": "node scripts/sync-client-files.mjs --check && node scripts/render-site-catalog.mjs --check && node scripts/check-links.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.5.0",
    "ignore": "^7.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "android",
    "kotlin",
    "jetpack-compose",
    "material3",
    "gradle",
    "adb",
    "mcp",
    "agent",
    "skill",
    "claude-code",
    "codex",
    "gemini-cli",
    "firebase"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nagarjuna2997/android-agent-skill.git"
  },
  "homepage": "https://nagarjuna2997.github.io/android-agent-skill/",
  "bugs": {
    "url": "https://github.com/Nagarjuna2997/android-agent-skill/issues"
  }
}
