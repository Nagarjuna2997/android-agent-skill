<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for API 31 and above. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device.xml" />
    </device-transfer>
</data-extraction-rules>
